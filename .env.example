# ── Casper / chain (gateway) ─────────────────────────────────────────────
CASPER_RPC_URL=https://node.testnet.casper.network/rpc
NEXT_PUBLIC_CASPER_RPC_URL=https://node.testnet.casper.network/rpc
NEXT_PUBLIC_CASPER_CHAIN=casper-test
NEXT_PUBLIC_CASPER_PLATFORM_PUBKEY=01xxxx...          # platform receiving account (public key)
CASPER_PLATFORM_ACCOUNT_HASH=account-hash-xxxx...     # same account, account-hash form (x402 validation)
CASPER_AGENT_ACCOUNT=account-hash-xxxx...             # registered hunter account for demo flows
CASPER_MIN_PAYMENT_MOTES=10000000                     # min accepted x402 payment (10^7 = 0.01 CSPR)
CASPER_ORACLE_READINGS_UREF=uref-xxxx...              # oracle dictionary urefs (see DEPLOYMENTS.md)
CASPER_ORACLE_REPUTATION_UREF=uref-xxxx...

# ── AI court / swarm ─────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-xxxx                      # powers tribunal / bounty-judge / hive
OLLAMA_URL=http://localhost:11434                     # optional local-model fallback
TRIBUNAL_DRY_RUN=1                                    # deliberate WITHOUT moving funds
SWARM_DATA_DIR=./swarm-data                           # agent state root (optional)

# ── Gateway execution / x402 routing (all optional, sane defaults) ──────
MESH_REPO_ROOT=.                                      # repo root for run_demo tooling
LOCAL_EXECUTION_HOOK=/tmp/x402_task_queue.jsonl
DYNAMIC_ROUTING_FEE=0.00
ENTERPRISE_THRESHOLD=5.00
WASM_SANDBOX_PLUGIN_PATH=./plugins/quarantine.wasm
